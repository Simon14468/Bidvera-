# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bidvera?schema=public"
# Neon: use the *pooler* URL and leave pool params to the app (pgbouncer + connection_limit).
# Optional overrides:
# PRISMA_CONNECTION_LIMIT=5
# PRISMA_POOL_TIMEOUT=20

# Auth (required — use a long random string in production; min 32 chars)
AUTH_SECRET="generate-a-secure-secret-at-least-32-chars"

# Google OAuth optional env fallback (prefer Super Admin → Auth → Google login vault)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft OAuth optional (Entra ID / Microsoft identity platform)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Tenant: "common" | "organizations" | "consumers" | or a directory (tenant) ID
MICROSOFT_TENANT_ID="common"

# AI (server-only — never expose to the client)
# Prefer Super Admin → AI models (encrypted vault) for OpenAI / Anthropic / Google keys.
# Env vars below remain optional fallbacks.
AI_PROVIDER="openai"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL_REASONING="gpt-5.6-sol"
AI_MODEL_EXTRACTION="gpt-5.6-luna"
# Optional env fallbacks (Super Admin vault overrides these when set)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
GEMINI_API_KEY=""

# ElevenLabs TTS optional env fallback (prefer Super Admin → AI Knowledge vault)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"

# Email (alerts + auth). Prefer Super Admin → Email (encrypted Resend vault).
# Env keys are optional bootstrap only — never use NEXT_PUBLIC_* for secrets.
RESEND_API_KEY=""
EMAIL_FROM="Bidvera <noreply@bidvera.com>"
# Optional SMTP documentation only — Resend is the supported sender today
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# PayPal subscriptions (current production provider — server-only, never NEXT_PUBLIC_*)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# sandbox | production  (legacy alias: PAYPAL_MODE=sandbox|live)
PAYPAL_ENVIRONMENT="sandbox"
# PAYPAL_MODE="sandbox"
PAYPAL_WEBHOOK_ID=""
# Optional env fallbacks if Super Admin plan IDs are empty (DB mapping is preferred)
PAYPAL_PLAN_STARTER=""
PAYPAL_PLAN_PRO=""
PAYPAL_PLAN_BUSINESS=""

# Stripe (optional — modular future provider; not required for PayPal)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# Super Admin (server-only — never expose path in sitemap/nav or commit real secrets)
# Required for every seed / `npm run sa:sync` (no silent fallbacks, no demo credentials).
# Production fails closed if SUPER_ADMIN_EMAIL or SUPER_ADMIN_PASSWORD is missing.
# Rotate after deploy: update env, then `npm run sa:sync` (rehashes password; revokes SA sessions).
SUPER_ADMIN_PATH="change-me-unguessable-path"
SUPER_ADMIN_EMAIL="you@your-company.com"
SUPER_ADMIN_PASSWORD="change-me-strong-password-12+"
SUPER_ADMIN_SESSION_HOURS="8"

# Rate limit backend: memory (local/dev/test only) | durable/db (production)
# Development defaults to memory even if unset. Production defaults to durable
# and rejects RATE_LIMIT_BACKEND=memory.
RATE_LIMIT_BACKEND="memory"

# Cloudflare Turnstile (bot protection). Secret is server-only — never NEXT_PUBLIC_*.
# Production requires both keys (fail closed). Local/test: leave empty to skip,
# or use Cloudflare dummy keys without weakening production:
#   TURNSTILE_SITE_KEY=1x00000000000000000000BB   (invisible always-pass)
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA  (always pass)
# TURNSTILE_ENABLED=true|false  (ignored in production — always required there)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Primary internal test company (Meridian) — optional password overrides for seed
MERIDIAN_OWNER_PASSWORD=""
MERIDIAN_ADMIN_PASSWORD=""
MERIDIAN_MEMBER_PASSWORD=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Bidvera"

# Search discovery (optional — never invent values; leave empty until issued)
# GOOGLE_SITE_VERIFICATION=""
# BING_SITE_VERIFICATION=""
# INDEXNOW_KEY=""
# When INDEXNOW_KEY is set, also host public/{INDEXNOW_KEY}.txt with the same key contents.

# Persistent upload storage (required durable path in production — not ephemeral container FS)
# STORAGE_ROOT=".data/uploads"

# Backup & disaster recovery (server-only)
# Encrypted archives are written to BACKUP_ROOT — never use STORAGE_ROOT / uploads.
# Production: set BACKUP_ROOT to a durable volume or off-host disk. Default .data/backups is local/ephemeral.
# BACKUP_ROOT=".data/backups"
# Direct (non-pooler) Postgres URL for pg_dump when available. Prisma logical dump is the fallback.
# DATABASE_URL_DIRECT=""
# Isolated restore target for operator-led restore. Must not equal DATABASE_URL.
# BACKUP_RESTORE_DATABASE_URL=""
# Optional failure alert recipient (defaults to SUPER_ADMIN_EMAIL)
# BACKUP_ALERT_EMAIL=""

# Production process notes (see docs/production-readiness.md):
# - NODE_ENV=production
# - Run APP (`npm run start`) and WORKER (`npm run worker`) as separate supervised processes
# - RATE_LIMIT_BACKEND must not be memory; durable Postgres buckets are used
# - PAYPAL_ENVIRONMENT=production for live charges (default sandbox is unsafe for prod)
# - Probes: GET /api/health (liveness), GET /api/ready (readiness)
# - Super Admin → Production readiness for itemized status

# Load test (dedicated Docker stack only — never production)
# LOAD_TEST_MODE=1
# LOAD_TEST_USER_COUNT=1000
# LOAD_TEST_REPORT_PATH=.data/load-test/latest-report.json
# See load-test/README.md

# Tender package upload limits (server-enforced; defaults suit realistic multi-doc packs under 130mb body limit)
# UPLOAD_MAX_FILE_BYTES=26214400
# UPLOAD_MAX_FILES_PER_PACKAGE=100
# UPLOAD_MAX_PACKAGE_BYTES=104857600
# UPLOAD_MAX_ARCHIVE_ENTRIES=250
# UPLOAD_MAX_COMPRESSION_RATIO=100
# UPLOAD_MAX_ARCHIVE_PATH_DEPTH=16
# UPLOAD_EXTRACT_CONCURRENCY=4
