model ComplianceExpiryReminder {
  id           String                   @id @default(cuid())
  companyId    String
  company      Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentId   String
  document     ComplianceDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  kind         ComplianceReminderKind
  /** Calendar fire date (date-only). */
  fireOnDate   DateTime                 @db.Date
  scheduledFor DateTime
  status       ComplianceReminderStatus @default(SCHEDULED)
  alertId      String?
  dedupeKey    String                   @unique
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([companyId, status])
  @@index([documentId, kind])
  @@index([scheduledFor, status])
}

model ComplianceReminderSettings {
