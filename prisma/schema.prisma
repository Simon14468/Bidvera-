/**
 * Derived matching snapshot for a company — never a duplicate source of truth.
 * Private company data stays in Company / SQ / DCM / QA; this holds match signals only.
 */
model CompanyMatchingProfile {
  id             String   @id @default(cuid())
  companyId      String   @unique
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /** Deterministic signal snapshot (trust-tiered dimensions). */
  snapshotJson   Json
  /** True when profile has enough trustworthy signals to enter the eligible pool. */
  eligible       Boolean  @default(false)
  completeness   Int      @default(0)
  contentHash    String
  version        Int      @default(1)
  /** Counts by trust tier — diagnostic only. */
  trustSummary   Json?
  builtAt        DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([eligible, updatedAt])
  @@index([contentHash])
}

/**
 * Public opportunity corpus for matching only — no private company data.
 */
model MatchingOpportunity {
  id              String                     @id @default(cuid())
  title           String
  summary         String?                    @db.Text
  category        String?
  industry        String?
  services        String[]                   @default([])
  industries      String[]                   @default([])
  geographies     String[]                   @default([])
  certifications  String[]                   @default([])
  sizeBand        String?
  experienceHint  String?
  deadline        DateTime?
  /** Source system key (e.g. INTERNAL) — algorithm-agnostic. */
  source          String                     @default("INTERNAL")
  externalRef     String?
  status          MatchingOpportunityStatus  @default(DRAFT)
  sponsored       Boolean                    @default(false)
  /** Soft sponsorship metadata — never overrides relevance. */
  sponsorshipMeta Json?
  /** Optional structured matching vector for future sources. */
  signalsJson     Json?
  /** Optional two-sided intent seam (8E) — public-safe only. */
  intentDirection MatchingIntentDirection    @default(UNSPECIFIED)
  /** Hash of public matching fields — skip no-op updates / trigger refresh. */
  contentHash     String?
  publishedAt     DateTime?
  pausedAt        DateTime?
  expiredAt       DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  recommendations MatchRecommendation[]
  behaviorEvents  MatchingBehaviorEvent[]
  dailyStats      MatchingOpportunityDailyStats[]
  sponsorships    MatchingSponsorship[]

  /**
   * Dedup natural key when externalRef is present.
   * PostgreSQL UNIQUE treats NULL as distinct — multiple null externalRefs allowed.
   */
  @@unique([source, externalRef])
  @@index([status, deadline])
  @@index([status, sponsored])
  @@index([updatedAt])
  @@index([contentHash])
}

/**
 * Sponsored Matching campaign (Feature 8F).
 * Relevance gate remains authoritative — sponsorship is secondary ranking only.
 */
model MatchingSponsorship {
  id                 String                     @id @default(cuid())
  opportunityId      String
  opportunity        MatchingOpportunity        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sponsorCompanyId   String
  sponsorCompany     Company                    @relation(fields: [sponsorCompanyId], references: [id], onDelete: Cascade)
  status             MatchingSponsorshipStatus  @default(DRAFT)
  startsAt           DateTime?
  endsAt             DateTime?
  /** Public-safe campaign fields only (name, budgetCents, currency). No private knowledge. */
  campaignMeta       Json?
  /** Billing seam — reserved; no real charges in 8F. */
  billingRef         String?
  billingStatus      String?
  activatedAt        DateTime?
  pausedAt           DateTime?
  endedAt            DateTime?
  createdByAdminId   String?
  updatedByAdminId   String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([sponsorCompanyId, status])
  @@index([opportunityId, status])
  @@index([status, endsAt])
  @@index([billingRef])
}

/**
 * SA-managed Sponsored Matching price catalog.
 * Prices are DB-driven — never hard-coded in company UI.
 * Does not affect Matching Engine scoring / relevance / ranking.
 */
model MatchingSponsorshipPricingPlan {
  id                   String                                   @id @default(cuid())
  name                 String
  description          String?                                  @db.Text
  priceCents           Int
  currency             String                                   @default("usd")
  billingPeriod        MatchingSponsorshipPricingBillingPeriod  @default(ONE_TIME)
  /** Campaign length for a purchased/requested sponsorship window. */
  campaignDurationDays Int?
  /** Soft commercial limits — never override relevance. */
  maxCampaigns         Int?
  maxImpressions       Int?
  /**
   * Optional segment key for future Starter/Growth/Professional/Enterprise
   * catalogs. Null = available to all segments.
   */
  segment              String?
  /**
   * Optional company-specific custom price. Null = catalog plan for all
   * companies (subject to segment).
   */
  companyId            String?
  company              Company?                                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status               MatchingSponsorshipPricingPlanStatus     @default(INACTIVE)
  displayOrder         Int                                      @default(0)
  /** Public-safe bullets describing what sponsorship provides. */
  benefits             String[]                                 @default([])
  createdAt            DateTime                                 @default(now())
  updatedAt            DateTime                                 @updatedAt

  requests MatchingSponsorshipPricingRequest[]

  @@index([status, displayOrder])
  @@index([companyId, status])
  @@index([segment, status])
}

/**
 * Company sponsorship pricing REQUEST / ORDER intent only.
 * No real payment processing — reuses NoOp billing seam.
 */
model MatchingSponsorshipPricingRequest {
  id            String                                   @id @default(cuid())
  companyId     String
  company       Company                                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId        String
  plan          MatchingSponsorshipPricingPlan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  status        MatchingSponsorshipPricingRequestStatus  @default(REQUESTED)
  /** Snapshot of selected commercial terms at request time. */
  planSnapshot  Json
  billingRef    String?
  billingStatus String?
  notes         String?                                  @db.Text
  createdAt     DateTime                                 @default(now())
  updatedAt     DateTime                                 @updatedAt

  @@index([companyId, status, createdAt])
  @@index([planId, status])
  @@index([billingRef])
}

model MatchRecommendation {
  id                 String                    @id @default(cuid())
  companyId          String
  company            Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityId      String
  opportunity        MatchingOpportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  type               MatchRecommendationType   @default(ORGANIC)
  score              Float
  confidence         Float
  matchedDimensions  Json
  reasons            String[]                  @default([])
  explanation        String?
  status             MatchRecommendationStatus @default(ACTIVE)
  /** Derived engagement quality from behavior events (8E). */
  qualityState       MatchQualityState         @default(NONE)
  /** Soft post-threshold ranking aids — never bypass relevance. */
  preferenceBoost    Float                     @default(0)
  geographyBoost     Float                     @default(0)
  aiRefineBoost      Float                     @default(0)
  finalRankScore     Float?
  isNew              Boolean                   @default(true)
  rankedAt           DateTime                  @default(now())
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  behaviorEvents MatchingBehaviorEvent[]

  @@unique([companyId, opportunityId])
  @@index([companyId, status, score])
  @@index([companyId, status, finalRankScore])
  @@index([companyId, rankedAt])
  @@index([opportunityId])
  @@index([companyId, qualityState])
}

/**
 * Soft behavioral preferences — NOT company capabilities (Feature 8E).
 */
model CompanyMatchingPreferenceSnapshot {
  id          String   @id @default(cuid())
  companyId   String   @unique
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /** Weighted public dimensions only (services/categories/industries/geos + dismiss). */
  weightsJson Json
  contentHash String
  version     Int      @default(1)
  builtAt     DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([contentHash])
  @@index([builtAt])
}

/** Per-opportunity daily rollup — avoid full event scans on dashboards. */
model MatchingOpportunityDailyStats {
  id                   String              @id @default(cuid())
  opportunityId        String
  opportunity          MatchingOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  /** UTC calendar day (midnight). */
  day                  DateTime            @db.Date
  impressions          Int                 @default(0)
  views                Int                 @default(0)
  clicks               Int                 @default(0)
  interest             Int                 @default(0)
  dismissals           Int                 @default(0)
  organicImpressions   Int                 @default(0)
  sponsoredImpressions Int                 @default(0)
  organicInterest      Int                 @default(0)
  sponsoredInterest    Int                 @default(0)
  updatedAt            DateTime            @updatedAt

  @@unique([opportunityId, day])
  @@index([day])
}

model MatchingPlatformDailyStats {
  id                   String   @id @default(cuid())
  day                  DateTime @unique @db.Date
  impressions          Int      @default(0)
  views                Int      @default(0)
  clicks               Int      @default(0)
  interest             Int      @default(0)
  dismissals           Int      @default(0)
  organicImpressions   Int      @default(0)
  sponsoredImpressions Int      @default(0)
  organicInterest      Int      @default(0)
  sponsoredInterest    Int      @default(0)
  updatedAt            DateTime @updatedAt
}

/**
 * Tenant-scoped matching behavior events — no private company profile payloads.
 * Foundation for Feature 8E analytics; not a full dashboard.
 */
model MatchingBehaviorEvent {
  id                 String                     @id @default(cuid())
  companyId          String
  company            Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityId      String
  opportunity        MatchingOpportunity        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  recommendationId   String?
  recommendation     MatchRecommendation?       @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  eventType          MatchingBehaviorEventType
  /** Denormalized for organic vs sponsored aggregates without joining recs. */
  recommendationType MatchRecommendationType?
  actorUserId        String?
  /** Optional de-dupe key (e.g. impression:company:rec:day). */
  idempotencyKey     String?
  /** Non-PII metadata only (e.g. { target: "view_opportunity" }). */
  metadata           Json?
  createdAt          DateTime                   @default(now())

  @@unique([companyId, idempotencyKey])
  @@index([companyId, createdAt])
  @@index([opportunityId, eventType, createdAt])
  @@index([eventType, createdAt])
  @@index([recommendationId])
}
