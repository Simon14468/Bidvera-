/** Buyer/client request for company information or documents — not Tender Analysis. */
model ClientRequest {
  id               String              @id @default(cuid())
  companyId        String
  company          Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientName       String
  title            String
  description      String?             @db.Text
  /** Instant when known; for date-only, UTC midnight of the calendar date. */
  deadline         DateTime
  /** True when only a calendar date was provided — no time invented. */
  deadlineDateOnly Boolean             @default(true)
  status           ClientRequestStatus @default(PENDING)
  progressPercent  Int                 @default(0)
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdByUserId  String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  items      ClientRequestItem[]
  activities ClientRequestActivity[]
  shares     ClientRequestShare[]
  reminders  ClientRequestReminder[]

  @@index([companyId, status])
  @@index([companyId, deadline])
  @@index([companyId, clientName])
  @@index([companyId, updatedAt])
}

model ClientRequestItem {
  id                   String                   @id @default(cuid())
  companyId            String
  company              Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestId            String
  request              ClientRequest            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  type                 ClientRequestItemType
  label                String
  description          String?
  sortOrder            Int                      @default(0)
  status               ClientRequestItemStatus  @default(PENDING)
  /** Optional note / answer for INFORMATION items. */
  informationValue     String?                  @db.Text
  linkSource           ClientRequestLinkSource?
  complianceDocumentId String?
  complianceDocument   ComplianceDocument?      @relation(fields: [complianceDocumentId], references: [id], onDelete: SetNull)
  supplierEvidenceId   String?
  supplierEvidence     SupplierQualificationEvidence? @relation(fields: [supplierEvidenceId], references: [id], onDelete: SetNull)
  completedAt          DateTime?
  completedByUserId    String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  shareItems ClientRequestShareItem[]

  @@index([companyId, requestId])
  @@index([requestId, status])
  @@index([complianceDocumentId])
  @@index([supplierEvidenceId])
}

model ClientRequestActivity {
  id          String                    @id @default(cuid())
  companyId   String
  company     Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestId   String
  request     ClientRequest             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorUserId String?
  eventType   ClientRequestActivityType
  message     String?                   @db.Text
  metadata    Json?
  createdAt   DateTime                  @default(now())

  @@index([requestId, createdAt])
  @@index([companyId, createdAt])
}

/** Revocable share dossier — token stored hashed; plaintext never persisted. */
model ClientRequestShare {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestId       String
  request         ClientRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  tokenPrefix     String
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  items ClientRequestShareItem[]

  @@index([companyId, requestId])
  @@index([requestId, revokedAt])
}

model ClientRequestShareItem {
  id        String            @id @default(cuid())
  shareId   String
  share     ClientRequestShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  itemId    String
  item      ClientRequestItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())

  @@unique([shareId, itemId])
  @@index([itemId])
}

model ClientRequestReminder {
  id        String                       @id @default(cuid())
  companyId String
  company   Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestId String
  request   ClientRequest                @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offset    ClientRequestReminderOffset
  fireAt    DateTime
  status    ClientRequestReminderStatus  @default(SCHEDULED)
  alertId   String?
  dedupeKey String                       @unique
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@index([companyId, status])
  @@index([requestId, offset])
  @@index([fireAt, status])
}

// ─── AI Questionnaire Assistant (Feature 7A — intelligence & persistence) ─────

enum QuestionnairePackStatus {
  EXTRACTED
  DRAFTING
  READY
  FAILED
}

enum QuestionnaireQuestionType {
  TEXT
  YES_NO
  NUMERIC
  DATE
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  ATTACHMENT
  UNKNOWN
}

enum QuestionnaireMandatoryStatus {
  MANDATORY
  OPTIONAL
  UNKNOWN
}

enum QuestionnaireDraftStatus {
  /** Supported by company evidence — still not Decision Engine evidence. */
  DRAFT_READY
  /** Evidence missing, ambiguous, stale, or insufficient — human must verify. */
  VERIFY
  APPROVED
  EDITED
  REJECTED
}

/** Extracted questionnaire pack for a tender — separate from Tender Analysis pipeline. */
model QuestionnairePack {
  id                 String                  @id @default(cuid())
  companyId          String
  company            Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenderId           String
  tender             Tender                  @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  title              String?
  status             QuestionnairePackStatus @default(EXTRACTED)
  /** Hash of source document texts — enables idempotent re-extract. */
  contentHash        String
  sourceDocumentIds  String[]                @default([])
  questionCount      Int                     @default(0)
  mandatoryCount     Int                     @default(0)
  extractedAt        DateTime                @default(now())
  lastDraftedAt      DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  sections  QuestionnaireSection[]
  questions QuestionnaireQuestion[]

  @@unique([companyId, tenderId, contentHash])
  @@index([companyId, tenderId])
  @@index([companyId, updatedAt])
  @@index([tenderId, status])
}

model QuestionnaireSection {
  id        String   @id @default(cuid())
  companyId String
  packId    String
  pack      QuestionnairePack @relation(fields: [packId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  questions QuestionnaireQuestion[]

  @@index([packId, sortOrder])
  @@index([companyId])
}

model QuestionnaireQuestion {
  id                   String                       @id @default(cuid())
  companyId            String
  company              Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  packId               String
  pack                 QuestionnairePack            @relation(fields: [packId], references: [id], onDelete: Cascade)
  sectionId            String?
  section              QuestionnaireSection?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sortOrder            Int                          @default(0)
  prompt               String                       @db.Text
  originalText         String                       @db.Text
  questionType         QuestionnaireQuestionType    @default(UNKNOWN)
  mandatoryStatus      QuestionnaireMandatoryStatus @default(UNKNOWN)
  /** Explicit answer options when present (choice questions). */
  answerOptions        String[]                     @default([])
  structuralContext    String?
  sourceDocumentId     String?
  sourceDocumentName   String
  sourcePage           Int?
  sourceSection        String?
  sourceSheet          String?
  sourceSlide          Int?
  sourceCell           String?
  /** Stable identity within a pack for idempotent upserts. */
  questionKey          String
  detectionConfidence  Float                        @default(0.5)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  drafts QuestionnaireDraftAnswer[]

  @@unique([packId, questionKey])
  @@index([companyId, packId])
  @@index([packId, sortOrder])
  @@index([companyId, mandatoryStatus])
}

/** AI draft answer — NEVER treated as verified company evidence or Decision Engine state. */
model QuestionnaireDraftAnswer {
  id                String                   @id @default(cuid())
  companyId         String
  company           Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  questionId        String
  question          QuestionnaireQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  status            QuestionnaireDraftStatus @default(VERIFY)
  draftText         String?                  @db.Text
  editedText        String?                  @db.Text
  /** Structured evidence cites — FactProvenance / SourceReference shaped JSON. */
  evidenceRefs      Json?
  confidence        Float?
  rationale         String?                  @db.Text
  generatedAt       DateTime                 @default(now())
  reviewedAt        DateTime?
  reviewedByUserId  String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([companyId, questionId])
  @@index([questionId, status])
  @@index([companyId, status])
  @@index([companyId, updatedAt])
}

