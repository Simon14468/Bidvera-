model Plan {
  id                String     @id @default(cuid())
  slug              String     @unique
  name              String
  description       String?
  monthlyPriceCents Int        @default(0)
  annualPriceCents  Int?
  /** Length of annual billing term in months (default 12) */
  annualMonths      Int        @default(12)
  monthlyEnabled    Boolean    @default(true)
  annualEnabled     Boolean    @default(true)
  currency          String     @default("usd")
  analysesLimit     Int        @default(3)
  /** When billingInterval=YEAR; null means use analysesLimit */
  analysesLimitYearly Int?
  aiTokensLimit     Int?
  storageMbLimit    Int?
  seatsLimit        Int        @default(1)
  /** When billingInterval=YEAR; null means use seatsLimit */
  seatsLimitYearly  Int?
  trialEligible     Boolean    @default(false)
  trialDays         Int?
  /** Days of paid access after payment failure; null = use global billing.graceDays */
  graceDays         Int?
  isFree            Boolean    @default(false)
  visibleToPublic   Boolean    @default(true)
  status            PlanStatus @default(ACTIVE)
  legacyEnum        SubscriptionPlan?
  /** @deprecated prefer paypalPlanMonthly / stripePriceMonthly */
  paypalPlanIdEnv   String?
  stripePriceEnv    String?
  stripeEnabled     Boolean    @default(true)
  paypalEnabled     Boolean    @default(true)
  stripePriceMonthly String?
  stripePriceAnnual  String?
  paypalPlanMonthly  String?
  paypalPlanAnnual   String?
  highlighted       Boolean    @default(false)
  sortOrder         Int        @default(0)
  /**
   * Display-only marketing bullets (NOT backend entitlements).
   * Prefer auto-generated labels from PlanFeature + numeric limits.
   * Extra lines here are marked display-only in Admin.
   */
  featureList       String[]   @default([])
  /** When true, public cards prefer entitlement-derived labels over featureList */
  preferEntitlementLabels Boolean @default(true)
  /**
   * Per-locale marketing copy for Paywall / upgrade UI.
   * Shape: { ar?: { name?, description?, features? }, es?, zh?, fr? }
   * English stays in name / description / featureList (canonical).
   */
  translations      Json?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  planFeatures PlanFeature[]
  overrides    CompanyPlanOverride[]
  subscriptions Subscription[]

  @@index([status])
  @@index([slug])
  @@index([visibleToPublic, status])
}

model Feature {
