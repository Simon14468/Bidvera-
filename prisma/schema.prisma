generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum DecisionType {
  BID
  REVIEW
  NO_BID
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequirementMatchStatus {
  MATCHED
  FAILED
  UNCERTAIN
  MISSING
}

enum TenderStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/** Real-world bid outcome recorded by the company — used for privacy-safe learning only after filtering. */
enum TenderOutcome {
  WON
  LOST
  WITHDRAWN
  CANCELLED
  NOT_SUBMITTED
  PENDING
  /** @deprecated use PENDING */
  BID_SUBMITTED
  /** @deprecated use NOT_SUBMITTED */
  NO_BID_CONFIRMED
}

/** Safe learning pattern lifecycle — only VERIFIED/ACTIVE may influence recommendations. */
enum LearningPatternLifecycle {
  CANDIDATE
  VALIDATING
  VERIFIED
  ACTIVE
  MONITORED
  RETIRED
}

enum AnalysisStatus {
  UPLOADING
  PROCESSING
  EXTRACTING
  ANALYZING
  COMPLETED
  FAILED
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum DocumentProcessingStatus {
  PENDING
  STORED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum EvidenceVerificationStatus {
  VERIFIED
  INFERRED
  UNKNOWN
}

enum MissingDocumentStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum RiskStatus {
  OPEN
  MITIGATED
  ACCEPTED
}

enum AlertType {
  DEADLINE_APPROACHING
  DEADLINE_PASSED
  MISSING_DOCUMENT
  HIGH_RISK
  DECISION_GENERATED
  TRIAL_LIMIT
  SYSTEM
  SCORE_CHANGED
  REQUIREMENT_STATUS
  DECISION_MEMORY
  WORKFLOW_EVENT
}

/** Document Compliance Manager — company document status (date-only expiry semantics). */
enum ComplianceStatus {
  VALID
  EXPIRING_SOON
  EXPIRED
  NO_EXPIRY
  UNKNOWN
}

enum ComplianceReminderKind {
  DAYS_90
  DAYS_30
  DAYS_7
  EXPIRED
}

enum ComplianceReminderStatus {
  SCHEDULED
  SENT
  CANCELLED
}

enum AlertStatus {
  SCHEDULED
  SENT
  READ
  DISMISSED
  CANCELLED
}

enum SubscriptionPlan {
  TRIAL
  STARTER
  PRO
  BUSINESS
  FREE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
  EXPIRED
  PAYMENT_FAILED
}

enum UsageAction {
  TENDER_ANALYSIS
  DOCUMENT_UPLOAD
  AI_EXTRACTION
  AI_REASONING
  CHECKOUT_STARTED
  UPGRADE_VIEWED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  DEAD
}

enum JobType {
  PROCESS_TENDER_DOCUMENT
  RUN_TENDER_ANALYSIS
  SEND_ALERT
  SCHEDULE_DEADLINE_ALERTS
  PROCESS_BILLING_WEBHOOK
  SEND_EMAIL
}

enum OnboardingStep {
  VERIFY_EMAIL
  COMPANY
  PLAN
  DONE
}

enum AuditAction {
  SIGNUP
  COMPANY_CREATED
  PROFILE_UPDATED
  TENDER_UPLOADED
  ANALYSIS_STARTED
  ANALYSIS_COMPLETED
  FIRST_DECISION
  DECISION_GENERATED
  TRIAL_USAGE
  UPGRADE_VIEWED
  CHECKOUT_STARTED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_CANCELED
  PAYMENT_FAILURE
  LOGIN
  LOGOUT
  EMAIL_VERIFIED
  EMAIL_VERIFICATION_SENT
  EMAIL_CHANGE_REQUESTED
  EMAIL_CHANGE_CANCELLED
  EMAIL_CHANGE_CONFIRMED
  EMAIL_CHANGED
  EMAIL_CHANGE_FAILED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  ONBOARDING_COMPANY
  ACCOUNT_PROFILE_UPDATED
  ONBOARDING_PLAN
  TENDER_OUTCOME_RECORDED
  LEARNING_CONTRIBUTED
  DECISION_MEMORY_RECORDED
  DECISION_MEMORY_COMPARED
  TEAM_TASK_CREATED
  TEAM_TASK_ASSIGNED
  TEAM_TASK_STATUS_CHANGED
  TEAM_TASK_RESPONDED
  TEAM_TASK_COMPLETED
  TEAM_TASK_REOPENED
  TEAM_TASK_VERIFIED
  TEAM_TASK_REJECTED
  TEAM_EVIDENCE_UPLOADED
  TEAM_CLOSED_LOOP_RERUN
  DECISION_MEMORY_REVISION
  DECISION_OUTCOME_RECORDED
  DECISION_OUTCOME_UPDATED
  EVIDENCE_FOUND
  VERIFICATION_REQUESTED
  VERIFIED
  VERIFICATION_REJECTED
  EVIDENCE_UPDATED
}

enum TrialRiskVerdict {
  ALLOW
  STEP_UP
  REVIEW
  BLOCK
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum FeatureScope {
  GLOBAL
  PLAN
  COMPANY
}

enum AiTaskType {
  PDF_EXTRACTION
  REQUIREMENT_EXTRACTION
  CLASSIFICATION
  COMPANY_MATCHING
  RISK_ANALYSIS
  FINAL_REASONING
}

enum BillingProvider {
  STRIPE
  PAYPAL
  MANUAL
}

enum BillingInterval {
  MONTH
  YEAR
}

enum BillingPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum BillingInvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum WebhookProcessStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum AdminRole {
  SUPER_ADMIN
  OPS
  READ_ONLY
}

// ─── Identity & tenancy ───────────────────────────────────────────────────────

model User {
  id              String         @id @default(cuid())
  companyId       String?
  company         Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  email           String         @unique
  emailVerified   Boolean        @default(false)
  passwordHash    String
  /** Public path for profile photo, e.g. /uploads/avatars/{userId}/….png */
  avatarUrl       String?
  role            UserRole       @default(OWNER)
  onboardingStep  OnboardingStep @default(VERIFY_EMAIL)
  acceptedTermsAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  sessions                 Session[]
  auditLogs                AuditLog[]
  decidedTenders           TenderDecision[]        @relation("DecidedBy")
  emailVerificationTokens  EmailVerificationToken[]
  emailChangeTokens        EmailChangeToken[]
  passwordResetTokens      PasswordResetToken[]
  assignedTeamTasks        TeamWorkflowTask[]      @relation("TeamTaskAssignee")
  createdTeamTasks         TeamWorkflowTask[]      @relation("TeamTaskCreator")
  completedTeamTasks       TeamWorkflowTask[]      @relation("TeamTaskCompleter")
  respondedTeamTasks       TeamWorkflowTask[]      @relation("TeamTaskResponder")
  verifiedTeamTasks        TeamWorkflowTask[]      @relation("TeamTaskVerifier")
  teamWorkflowEvents       TeamWorkflowEvent[]     @relation("TeamWorkflowEventActor")
  targetedAlerts           Alert[]                 @relation("AlertTargetUser")

  @@index([companyId])
  @@index([email])
  @@index([onboardingStep])
}

model EmailVerificationToken {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  /** AES-GCM ciphertext of raw link token for worker delivery — never log; clear after send/use. */
  deliverySecretEnc String?
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/** Pending email change — applied only after the new address clicks the confirm link. */
model EmailChangeToken {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail        String
  tokenHash       String    @unique
  deliverySecretEnc String?
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([newEmail])
  @@index([expiresAt])
}

model PasswordResetToken {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  deliverySecretEnc String?
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/** One-time Super Admin enter-company exchange — raw session never in the URL. */
model SaEnterClaim {
  id                String    @id @default(cuid())
  sessionTokenEnc   String
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([expiresAt])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String   @unique
  expiresAt        DateTime
  ipHash           String?
  userAgentHash    String?
  deviceFingerprint String?
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Company {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  domain        String?
  country       String?
  companySize   String?
  status        CompanyStatus @default(ACTIVE)
  suspendedAt   DateTime?
  suspendReason String?
  /**
   * Opt into contributing anonymized outcomes to the global learning layer.
   * Company-private outcomes remain available regardless.
   */
  globalLearningConsent Boolean @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  users         User[]
  profile       CompanyProfile?
  usage         CompanyUsage?
  subscription  Subscription?
  notificationPrefs CompanyNotificationPrefs?
  tenders       Tender[]
  alerts        Alert[]
  usageRecords  UsageRecord[]
  jobs          Job[]
  auditLogs     AuditLog[]
  trialSignals  TrialRiskSignal[]
  planOverride  CompanyPlanOverride?
  featureOverrides CompanyFeatureOverride[]
  aiUsageLogs   AiUsageLog[]
  subscriptionEvents SubscriptionEvent[]
  billingPayments BillingPayment[]
  billingInvoices BillingInvoice[]
  decisionMemories DecisionMemory[]
  decisionMemoryRevisions DecisionMemoryRevision[]
  tenderDecisionOutcomes TenderDecisionOutcome[]
  teamWorkflowTasks TeamWorkflowTask[]
  teamWorkflowEvents TeamWorkflowEvent[]
  complianceDocuments ComplianceDocument[]
  complianceDocumentCategories ComplianceDocumentCategory[]
  complianceDocumentVersions ComplianceDocumentVersion[]
  complianceExpiryReminders ComplianceExpiryReminder[]
  complianceReminderSettings ComplianceReminderSettings?
  supplierQualificationProfile SupplierQualificationProfile?
  calendarTenders CalendarTender[]
  calendarTenderDeadlines CalendarTenderDeadline[]
  calendarTenderEvents CalendarTenderEvent[]
  calendarTenderReminders CalendarTenderReminder[]
  calendarTenderReminderSettings CalendarTenderReminderSettings?
  clientRequests ClientRequest[]
  clientRequestItems ClientRequestItem[]
  clientRequestActivities ClientRequestActivity[]
  clientRequestShares ClientRequestShare[]
  clientRequestReminders ClientRequestReminder[]
  reportShares ReportShare[]
  questionnairePacks QuestionnairePack[]
  questionnaireQuestions QuestionnaireQuestion[]
  questionnaireDraftAnswers QuestionnaireDraftAnswer[]
  matchingProfile CompanyMatchingProfile?
  matchingPreferenceSnapshot CompanyMatchingPreferenceSnapshot?
  matchRecommendations MatchRecommendation[]
  matchingBehaviorEvents MatchingBehaviorEvent[]
  matchingSponsorships MatchingSponsorship[]
  matchingSponsorshipPricingPlans MatchingSponsorshipPricingPlan[]
  matchingSponsorshipPricingRequests MatchingSponsorshipPricingRequest[]

  @@index([slug])
  @@index([domain])
  @@index([status])
  @@index([createdAt])
}

model CompanyProfile {
  id                       String   @id @default(cuid())
  companyId                String   @unique
  company                  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  industry                 String?
  country                  String?
  companySize              String?
  /** Optional categorical experience for tender-fit (not a sensitive field). */
  experienceLevel          String?
  services                 String[] @default([])
  certifications           String[] @default([])
  experienceYears          Int?
  revenueRange             String?
  employeeRange            String?
  geographicCoverage       String[] @default([])
  contractSizeMin          Int?
  contractSizeMax          Int?
  customQualificationRules String[] @default([])
  /**
   * Structured company knowledge extracted from uploaded evidence (with provenance).
   * Flat columns above remain the matching surface; this is the source-of-truth trace.
   */
  knowledgeJson            Json?
  completeness             Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model CompanyUsage {
  id             String   @id @default(cuid())
  companyId      String   @unique
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  analysesUsed   Int      @default(0)
  analysesLimit  Int      @default(3)
  /** Billing-period window for analysesUsed (aligned to subscription period, not calendar month). */
  periodStart    DateTime?
  periodEnd      DateTime?
  updatedAt      DateTime @updatedAt
}

// ─── Tenders ──────────────────────────────────────────────────────────────────

model Tender {
  id               String         @id @default(cuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title            String
  client           String?
  country          String?
  region           String?
  industry         String?
  deadline         DateTime?
  deadlineTimezone String?
  estimatedValue   Int?
  guarantee        String?
  status           TenderStatus   @default(DRAFT)
  analysisStatus   AnalysisStatus @default(UPLOADING)
  analysisError    String?
  /** Fine-grained phase for upload progress (READING_PDF, OCR, CLASSIFYING, …). */
  analysisPhase    String?
  idempotencyKey   String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  analyzedAt       DateTime?
  /** Company-private outcome — never exposed cross-tenant; only coarse features enter learning. */
  outcome          TenderOutcome?
  outcomeRecordedAt DateTime?
  /** Coarse learning fingerprint stored at analysis time (no PII / no document text). */
  learningFeatureKey String?

  documents    TenderDocument[]
  requirements TenderRequirement[]
  risks        TenderRisk[]
  evidence     TenderEvidence[]
  decision     TenderDecision?
  missingDocs  MissingDocument[]
  nextActions  NextAction[]
  alerts       Alert[]
  jobs         Job[]
  learningContribution LearningContribution?
  decisionMemory       DecisionMemory?
  decisionMemoryRevisions DecisionMemoryRevision[]
  decisionOutcome      TenderDecisionOutcome?
  teamWorkflowTasks    TeamWorkflowTask[]
  questionnairePacks QuestionnairePack[]
  reportShares ReportShare[]

  @@unique([companyId, idempotencyKey])
  @@index([companyId])
  @@index([companyId, analysisStatus])
  @@index([companyId, deadline])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([learningFeatureKey])
  @@index([outcome])
}

/** Revocable report share links. Legacy HMAC tokens remain valid until expiry. */
model ReportShare {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenderId        String
  tender          Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  @@index([companyId, tenderId])
  @@index([tenderId, revokedAt])
}

model TenderDocument {
  id               String                   @id @default(cuid())
  tenderId         String
  tender           Tender                   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  companyId        String
  fileName         String
  storageKey       String
  mimeType         String
  fileSize         Int
  checksumSha256   String?
  processingStatus DocumentProcessingStatus @default(PENDING)
  extractedText    String?                  @db.Text
  pageCount        Int?
  /** Extraction provenance: method, pages[{page,method,confidence}], usedOcrFallback */
  extractionMeta   Json?
  /** COMPANY_PROFILE | TENDER | SUPPORTING_EVIDENCE | HISTORICAL_OUTCOME */
  documentKind     String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([tenderId])
  @@index([companyId])
  @@index([storageKey])
  @@index([documentKind])
}

model TenderRequirement {
  id          String                 @id @default(cuid())
  tenderId    String
  tender      Tender                 @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  category    String
  description String
  mandatory   Boolean                @default(true)
  value       String?
  status      RequirementMatchStatus @default(UNCERTAIN)
  sourcePage  Int?
  sourceSection String?
  evidence    String?
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())

  evidenceLinks TenderEvidence[]
  teamTasks     TeamWorkflowTask[]

  @@index([tenderId])
  @@index([tenderId, status])
}

model TenderRisk {
  id          String       @id @default(cuid())
  tenderId    String
  tender      Tender       @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  severity    RiskSeverity
  category    String
  description String
  sourcePage  Int?
  status      RiskStatus   @default(OPEN)
  mitigation  String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())

  teamTasks TeamWorkflowTask[]

  @@index([tenderId])
  @@index([tenderId, severity])
}

model TenderEvidence {
  id                 String                      @id @default(cuid())
  tenderId           String
  tender             Tender                      @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  requirementId      String?
  requirement        TenderRequirement?          @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  documentId         String?
  sourcePage         Int?
  sourceSection      String?
  evidenceText       String
  verificationStatus EvidenceVerificationStatus  @default(UNKNOWN)
  verificationReason String?                     @db.Text
  verifiedById       String?
  verifiedAt         DateTime?
  /** Provenance link to team workflow task when evidence came from verified team response */
  teamTaskId         String?
  createdAt          DateTime                    @default(now())

  @@index([tenderId])
  @@index([requirementId])
  @@index([teamTaskId])
  @@index([documentId])
}

model RequirementVerificationAudit {
  id            String   @id @default(cuid())
  companyId     String
  tenderId      String
  requirementId String
  evidenceId    String?
  userId        String?
  action        String
  snapshot      Json
  createdAt     DateTime @default(now())

  @@index([companyId, tenderId])
  @@index([requirementId])
  @@index([companyId, createdAt])
}

model MissingDocument {
  id           String                @id @default(cuid())
  tenderId     String
  tender       Tender                @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  documentName String
  reason       String
  severity     RiskSeverity          @default(MEDIUM)
  status       MissingDocumentStatus @default(OPEN)
  sortOrder    Int                   @default(0)
  createdAt    DateTime              @default(now())

  teamTasks TeamWorkflowTask[]

  @@index([tenderId])
}

model NextAction {
  id          String   @id @default(cuid())
  tenderId    String
  tender      Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    Int      @default(0)
  completed   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([tenderId])
}

// ─── Team Decision Workflow ───────────────────────────────────────────────────

enum TeamWorkflowTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum TeamWorkflowDepartment {
  FINANCE
  LEGAL
  TECHNICAL
  MANAGEMENT
  PROCUREMENT
  COMMERCIAL
  OPERATIONS
  OTHER
}

enum TeamWorkflowTaskKind {
  REQUIREMENT_GAP
  RISK_MITIGATION
  MISSING_DOCUMENT
  CLARIFICATION
  EVIDENCE_REQUEST
  CUSTOM
}

enum TeamWorkflowEventType {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  RESPONSE_ADDED
  EVIDENCE_LINKED
  COMPLETED
  REOPENED
  COMMENT
  VERIFICATION_REQUESTED
  VERIFIED
  REJECTED
  REQUIREMENT_UPDATED
  DECISION_RERUN
}

/**
 * Team evidence verification — NEVER auto-VERIFIED.
 * NONE = no response yet; PENDING = awaiting human verifier;
 * VERIFIED / REJECTED = explicit human judgment.
 */
enum TeamEvidenceVerificationStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

/** Human team task linked to a tender item — never invents evidence. */
model TeamWorkflowTask {
  id               String                   @id @default(cuid())
  companyId        String
  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenderId         String
  tender           Tender                   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  kind             TeamWorkflowTaskKind
  title            String
  description      String?                  @db.Text
  /** What response is required from the assignee (plain language). */
  requiredResponse String?                  @db.Text
  department       TeamWorkflowDepartment?
  assigneeUserId   String?
  assigneeUser     User?                    @relation("TeamTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  status           TeamWorkflowTaskStatus    @default(PENDING)
  priority         RiskSeverity             @default(MEDIUM)
  deadline         DateTime?
  /** Team response text — unverified until verificationStatus=VERIFIED */
  responseText     String?                  @db.Text
  /** Optional link back to uploaded evidence text / note */
  evidenceNote     String?                  @db.Text
  responseSubmittedAt   DateTime?
  responseSubmittedById String?
  responseSubmittedBy   User?  @relation("TeamTaskResponder", fields: [responseSubmittedById], references: [id], onDelete: SetNull)
  verificationStatus    TeamEvidenceVerificationStatus @default(NONE)
  verifiedAt            DateTime?
  verifiedById          String?
  verifiedBy            User?  @relation("TeamTaskVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verificationNote      String? @db.Text
  /** Applied only when VERIFIED — exact requirement status chosen by verifier */
  appliedRequirementStatus RequirementMatchStatus?
  /** Provenance: TenderEvidence created on VERIFIED */
  verifiedEvidenceId    String?
  requirementId    String?
  requirement      TenderRequirement?       @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  riskId           String?
  risk             TenderRisk?              @relation(fields: [riskId], references: [id], onDelete: SetNull)
  missingDocId     String?
  missingDoc       MissingDocument?         @relation(fields: [missingDocId], references: [id], onDelete: SetNull)
  /** Stable id from intelligence ClarificationQuestion when not a Prisma row */
  clarificationId  String?
  /** Idempotent seed/create key — prevents duplicate tasks for the same source */
  dedupeKey        String                   @unique
  /** Prevents duplicate closed-loop re-analysis for the same verified payload */
  closedLoopHash   String?
  createdById      String?
  createdBy        User?                    @relation("TeamTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  completedAt      DateTime?
  completedById    String?
  completedBy      User?                    @relation("TeamTaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  events      TeamWorkflowEvent[]
  attachments TeamWorkflowAttachment[]

  @@index([companyId, status])
  @@index([companyId, assigneeUserId, status])
  @@index([companyId, verificationStatus])
  @@index([tenderId, status])
  @@index([tenderId, priority])
  @@index([deadline])
  @@index([requirementId])
  @@index([riskId])
  @@index([missingDocId])
  @@index([closedLoopHash])
}

model TeamWorkflowEvent {
  id          String                @id @default(cuid())
  companyId   String
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId      String
  task        TeamWorkflowTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?                 @relation("TeamWorkflowEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  eventType   TeamWorkflowEventType
  fromStatus  TeamWorkflowTaskStatus?
  toStatus    TeamWorkflowTaskStatus?
  message     String?               @db.Text
  metadata    Json?
  createdAt   DateTime              @default(now())

  @@index([taskId, createdAt])
  @@index([companyId, createdAt])
}

model TeamWorkflowAttachment {
  id             String           @id @default(cuid())
  companyId      String
  taskId         String
  task           TeamWorkflowTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName       String
  storageKey     String
  mimeType       String
  fileSize       Int
  checksumSha256 String?
  uploadedById   String?
  createdAt      DateTime         @default(now())

  @@index([taskId])
  @@index([companyId])
  @@index([storageKey])
}

// ─── Alerts, usage, billing ───────────────────────────────────────────────────

model Alert {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenderId     String?
  tender       Tender?     @relation(fields: [tenderId], references: [id], onDelete: SetNull)
  type         AlertType
  title        String
  message      String
  href         String?
  /** Optional primary recipient (assignee/verifier) — still tenant-scoped */
  targetUserId String?
  targetUser   User?       @relation("AlertTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  /** Stable key for idempotent scheduling (e.g. company:tender:deadline:7d) */
  dedupeKey    String?     @unique
  scheduledFor DateTime?
  status       AlertStatus @default(SCHEDULED)
  createdAt    DateTime    @default(now())
  sentAt       DateTime?
  readAt       DateTime?
  /** When email channel successfully delivered (null if email disabled or not yet sent) */
  emailSentAt  DateTime?
  /** Delivery attempts for retryable channel sends */
  attemptCount Int         @default(0)
  lastError    String?

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([scheduledFor, status])
  @@index([tenderId])
  @@index([targetUserId])
}

/** Per-company notification preferences — channels are modular for future WhatsApp/SMS/push. */
model CompanyNotificationPrefs {
  companyId            String   @id
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /** IANA timezone for deadline wall-clock scheduling/display (e.g. Africa/Casablanca) */
  timezone             String   @default("UTC")
  inAppEnabled         Boolean  @default(true)
  emailEnabled         Boolean  @default(true)
  whatsappEnabled      Boolean  @default(false)
  smsEnabled           Boolean  @default(false)
  pushEnabled          Boolean  @default(false)
  deadlineAlert7d      Boolean  @default(true)
  deadlineAlert3d      Boolean  @default(true)
  deadlineAlert24h     Boolean  @default(true)
  deadlineAlertPassed  Boolean  @default(true)
  highRiskAlerts       Boolean  @default(true)
  decisionAlerts       Boolean  @default(true)
  missingDocAlerts     Boolean  @default(true)
  scoreChangeAlerts    Boolean  @default(true)
  requirementAlerts    Boolean  @default(true)
  decisionMemoryAlerts Boolean  @default(true)
  workflowAlerts       Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model UsageRecord {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  action    UsageAction
  quantity  Int         @default(1)
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([companyId, action])
  @@index([companyId, createdAt])
}

model Subscription {
  id                     String             @id @default(cuid())
  companyId              String             @unique
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider               String             @default("paypal")
  providerCustomerId     String?
  providerSubscriptionId String?
  plan                   SubscriptionPlan   @default(TRIAL)
  planId                 String?
  billingPlan            Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  status                 SubscriptionStatus @default(TRIALING)
  billingInterval        BillingInterval?
  paymentMethodBrand     String?
  paymentMethodLast4     String?
  /** First time this subscription became active/trialing (immutable once set). */
  startedAt              DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  /**
   * When set, PAST_DUE / PAYMENT_FAILED keep access until this instant.
   * Cleared on successful renewal / reactivation.
   */
  gracePeriodEndsAt      DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  events   SubscriptionEvent[]
  payments BillingPayment[]
  invoices BillingInvoice[]

  @@index([providerCustomerId])
  @@index([providerSubscriptionId])
  @@index([status])
  @@index([planId])
  @@index([provider, status])
  @@index([currentPeriodEnd])
  @@index([gracePeriodEndsAt])
}

model SubscriptionEvent {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  eventType      String
  fromStatus     String?
  toStatus       String?
  fromPlan       String?
  toPlan         String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([subscriptionId])
}

model TenderDecision {
  id            String          @id @default(cuid())
  tenderId      String          @unique
  tender        Tender          @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  companyId     String
  decision      DecisionType
  fitScore      Int
  confidence    ConfidenceLevel @default(MEDIUM)
  reasoning     String
  /** Structured company–tender fit breakdown (dimensions, matches, unknowns). */
  fitBreakdown  Json?
  /** Tender readiness / requirements gap snapshot (READY/MISSING/VERIFY/…). */
  readinessBreakdown Json?
  /** Compliance matrix, risks, contradictions, clarification questions. */
  intelligenceBreakdown Json?
  /** Bid Score + Expected Value prioritization layer (not win probability). */
  bidScoreBreakdown Json?
  decidedById   String?
  decidedBy     User?           @relation("DecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  isAiSuggested Boolean         @default(true)
  aiProvider    String?
  aiModel       String?
  aiTask        String?
  tokensIn      Int?
  tokensOut     Int?
  costCentsEst  Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  decisionOutcome TenderDecisionOutcome?

  @@index([companyId])
  @@index([companyId, decision])
}

/**
 * Authoritative real-world outcome for a finalized tender decision.
 * One row per tender — idempotent upsert; audit trail in TenderDecisionOutcomeAudit.
 */
model TenderDecisionOutcome {
  id                 String         @id @default(cuid())
  companyId          String
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenderId           String         @unique
  tender             Tender         @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  tenderDecisionId   String         @unique
  tenderDecision     TenderDecision   @relation(fields: [tenderDecisionId], references: [id], onDelete: Cascade)
  outcome            TenderOutcome
  outcomeDate        DateTime?
  reasonCode         String?
  reasonDetail       String?        @db.Text
  evidence           Json?
  humanFinalDecision DecisionType?
  recordedById       String?
  idempotencyKey     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  audits TenderDecisionOutcomeAudit[]

  @@unique([companyId, idempotencyKey])
  @@index([companyId, outcome])
  @@index([companyId, createdAt])
}

model TenderDecisionOutcomeAudit {
  id        String                @id @default(cuid())
  outcomeId String
  outcome   TenderDecisionOutcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  companyId String
  userId    String?
  action    String
  snapshot  Json
  createdAt DateTime              @default(now())

  @@index([outcomeId])
  @@index([companyId, createdAt])
}

/**
 * Company-private Decision Memory — immutable analysis snapshot for prior tenders.
 * Reference/context only: never invents data and never changes current tender scores.
 * One record per tender (unique tenderId) prevents duplicates.
 */
model DecisionMemory {
  id                   String          @id @default(cuid())
  companyId            String
  company              Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenderId             String          @unique
  tender               Tender          @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  /** Engine decision: BID=GO, REVIEW=CONDITIONAL GO, NO_BID=NO-BID */
  decision             DecisionType
  title                String
  client               String?
  country              String?
  industry             String?
  fitScore             Int?
  readinessScore       Int?
  bidScore             Int?
  confidence           ConfidenceLevel @default(MEDIUM)
  reasoning            String
  /** Requirement totals + short requirement lines from canonical analysis only */
  requirementsSnapshot Json
  /** Risk titles/severities copied from analysis — never fabricated */
  risksSnapshot        Json
  /** Fit / readiness / bid score display snapshot */
  scoresSnapshot       Json
  /** Privacy-safe learning features for relevance matching */
  relevanceFeatures    Json
  featureKey           String
  analyzedAt           DateTime
  /** Integrity hash of stored decision fields — blocks empty/corrupt overwrites */
  contentHash          String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([companyId, tenderId])
  @@index([companyId, analyzedAt])
  @@index([companyId, decision])
  @@index([companyId, featureKey])

  revisions DecisionMemoryRevision[]
}

/**
 * Append-only Decision Memory history — never overwrites prior snapshots.
 * Current DecisionMemory row remains the latest view for relevance matching.
 */
model DecisionMemoryRevision {
  id                   String          @id @default(cuid())
  companyId            String
  company              Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenderId             String
  tender               Tender          @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  memoryId             String?
  memory               DecisionMemory? @relation(fields: [memoryId], references: [id], onDelete: SetNull)
  decision             DecisionType
  title                String
  client               String?
  country              String?
  industry             String?
  fitScore             Int?
  readinessScore       Int?
  bidScore             Int?
  confidence           ConfidenceLevel @default(MEDIUM)
  reasoning            String
  requirementsSnapshot Json
  risksSnapshot        Json
  scoresSnapshot       Json
  relevanceFeatures    Json
  featureKey           String
  analyzedAt           DateTime
  contentHash          String
  /** ANALYSIS | TEAM_VERIFIED_EVIDENCE */
  source               String          @default("ANALYSIS")
  triggerTaskId        String?
  createdAt            DateTime        @default(now())

  @@unique([companyId, tenderId, contentHash])
  @@index([companyId, tenderId, createdAt])
  @@index([memoryId])
  @@index([triggerTaskId])
}

/**
 * Idempotent record that a company's tender outcome contributed to learning.
 * companyId is for ops/idempotency only — never returned in cross-company signals.
 */
model LearningContribution {
  id          String        @id @default(cuid())
  companyId   String
  tenderId    String        @unique
  tender      Tender        @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  featureKey  String
  outcome     TenderOutcome
  /** Coarse feature JSON after privacy filter — no titles, clients, docs, or company names. */
  features    Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([companyId])
  @@index([featureKey])
  @@index([outcome])
}

/**
 * Anonymized aggregated patterns. No company IDs, tender titles, documents, or identities.
 * Only VERIFIED / ACTIVE lifecycle states may influence recommendations.
 */
model AggregatedLearningPattern {
  id                   String                   @id @default(cuid())
  featureKey           String                   @unique
  industryBucket       String
  countryBucket        String
  sizeBand             String
  fitBand              String
  readinessBand        String
  decisionAtAnalysis   DecisionType
  mandatoryGapBand     String
  valueBand            String
  sampleCount          Int                      @default(0)
  wonCount             Int                      @default(0)
  lostCount            Int                      @default(0)
  bidSubmittedCount    Int                      @default(0)
  noBidCount           Int                      @default(0)
  withdrawnCount       Int                      @default(0)
  independentOrgCount  Int                      @default(0)
  decisiveOutcomeCount Int                      @default(0)
  /** 0–100 */
  dataQualityScore     Int                      @default(0)
  /** 0–100 */
  consistencyScore     Int                      @default(0)
  /** Max single-org contribution share in basis points (0–10000). */
  maxOrgShareBps       Int                      @default(10000)
  lifecycle            LearningPatternLifecycle @default(CANDIDATE)
  /** Derived: true only when lifecycle is VERIFIED or ACTIVE. */
  validated            Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([lifecycle, validated])
  @@index([validated, sampleCount])
  @@index([industryBucket, countryBucket])
}

model Job {
  id          String    @id @default(cuid())
  companyId   String?
