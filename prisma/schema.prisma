enum CalendarTenderStatus {
  OPEN
  WATCHING
  SUBMITTED
  CLOSED
  CANCELLED
}

enum CalendarDeadlineType {
  SUBMISSION
  CLARIFICATION
  OPENING
  SITE_VISIT
  MEETING
  OTHER
}

enum CalendarMilestoneStatus {
  SCHEDULED
  DUE_TODAY
  PAST
  CANCELLED
}

enum CalendarReminderOffset {
  DAYS_30
  DAYS_14
  DAYS_7
  DAYS_3
  DAYS_1
  SAME_DAY
}

enum CalendarReminderStatus {
  SCHEDULED
  SENT
  CANCELLED
}

/** Calendar-tracked tender — NOT the Tender Analysis pipeline model. */
model CalendarTender {
  id              String               @id @default(cuid())
  companyId       String
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title           String
  referenceNumber String?
  buyerAuthority  String?
  country         String?
  category        String?
  description     String?              @db.Text
  status          CalendarTenderStatus @default(OPEN)
  sourceUrl       String?
  notes           String?              @db.Text
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  deadlines CalendarTenderDeadline[]
  events    CalendarTenderEvent[]
  reminders CalendarTenderReminder[]

  @@index([companyId, status])
  @@index([companyId, country])
  @@index([companyId, category])
  @@index([companyId, updatedAt])
}

model CalendarTenderDeadline {
  id         String                 @id @default(cuid())
  companyId  String
  company    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenderId   String
  tender     CalendarTender         @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  type       CalendarDeadlineType   @default(SUBMISSION)
  title      String
  /** Instant when known; for date-only, UTC midnight of the calendar date. */
  occursAt   DateTime
  /** True when only a calendar date was provided — no time invented. */
  dateOnly   Boolean                @default(false)
  /** IANA timezone only when explicitly provided by the user — never invented. */
  timezone   String?
  source     String?
  notes      String?
  status     CalendarMilestoneStatus @default(SCHEDULED)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  reminders CalendarTenderReminder[]

  @@index([companyId, occursAt])
  @@index([companyId, tenderId])
  @@index([tenderId, type, occursAt])
}

model CalendarTenderEvent {
  id         String                  @id @default(cuid())
  companyId  String
  company    Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenderId   String
  tender     CalendarTender          @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  type       CalendarDeadlineType    @default(OTHER)
  title      String
  occursAt   DateTime
  dateOnly   Boolean                 @default(false)
  timezone   String?
  source     String?
  notes      String?
  status     CalendarMilestoneStatus @default(SCHEDULED)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([companyId, tenderId, type, title, occursAt])
  @@index([companyId, occursAt])
  @@index([companyId, tenderId])
}

model CalendarTenderReminder {
  id           String                 @id @default(cuid())
  companyId    String
  company      Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenderId     String
  tender       CalendarTender         @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  deadlineId   String
  deadline     CalendarTenderDeadline @relation(fields: [deadlineId], references: [id], onDelete: Cascade)
  offset       CalendarReminderOffset
  fireAt       DateTime
  status       CalendarReminderStatus @default(SCHEDULED)
  alertId      String?
  dedupeKey    String                 @unique
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([companyId, status])
  @@index([deadlineId, offset])
  @@index([fireAt, status])
}

model CalendarTenderReminderSettings {
  companyId   String  @id
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  remind30d   Boolean @default(true)
  remind14d   Boolean @default(true)
  remind7d    Boolean @default(true)
  remind3d    Boolean @default(true)
  remind1d    Boolean @default(true)
  remindSameDay Boolean @default(true)
  updatedAt   DateTime @updatedAt
}

