  document        ComplianceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber   Int
  storageKey      String
  fileName        String
  mimeType        String
  byteLength      Int
  checksumSha256  String?
  /** Truncated extracted text for diagnostics — never treated as actionable. */
  extractedTextPreview String? @db.Text
