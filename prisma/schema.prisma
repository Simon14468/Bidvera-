  idempotencyKey String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@unique([type, idempotencyKey])
  @@index([status, availableAt])
  @@index([companyId])
  @@index([tenderId])
}

model AuditLog {
  id        String      @id @default(cuid())
