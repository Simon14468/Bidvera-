# Bidvera Next.js application (production) — single instance on :3000
# Install: copy to /etc/systemd/system/bidvera-app.service
# For multiple instances on one host, prefer deploy/systemd/bidvera-app@.service
#   (ports 3000/3001/3002) and matching servers in deploy/nginx/bidvera.conf.
# Adjust User, WorkingDirectory, EnvironmentFile, and Node path for your host.

[Unit]
Description=Bidvera Next.js app
Documentation=file:///opt/bidvera/docs/production-deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bidvera
Group=bidvera
WorkingDirectory=/opt/bidvera/current
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Environment=INSTANCE_ID=app-3000
EnvironmentFile=-/etc/bidvera/env
# Prefer Node 22 LTS binary (nvm/fnm/system). Example paths — edit for the host:
# Environment=PATH=/usr/local/bin:/usr/bin
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=45
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bidvera-app
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/bidvera /var/lib/bidvera
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
