# Bidvera background worker (production)
# Install: copy to /etc/systemd/system/bidvera-worker.service
# Must share the same EnvironmentFile as bidvera-app* (DATABASE_URL, AUTH_SECRET, STORAGE_ROOT, etc.).
#
# One worker per host is the default. Jobs use DB claim locks — do not run analysis inside web
# request paths for production correctness. Worker does NOT depend on bidvera-app.service so
# multi-instance (@3000/@3001/@3002) topologies start cleanly without the single-instance unit.

[Unit]
Description=Bidvera job worker
Documentation=file:///opt/bidvera/docs/production-deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bidvera
Group=bidvera
WorkingDirectory=/opt/bidvera/current
Environment=NODE_ENV=production
Environment=INSTANCE_ID=worker
EnvironmentFile=-/etc/bidvera/env
# Prefer Node 22 LTS binary (nvm/fnm/system). Example paths — edit for the host:
# Environment=PATH=/usr/local/bin:/usr/bin
ExecStart=/usr/bin/npm run worker
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
# Longer than app units — allow in-flight job claim release / OCR cleanup
TimeoutStopSec=90
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bidvera-worker
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/bidvera /var/lib/bidvera
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
