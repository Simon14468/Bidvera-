# Bidvera PRODUCTION environment template
# Copy to the server as /etc/bidvera/env (mode 0600, owner root:bidvera).
# NEVER commit real secrets. NEVER use sandbox/dummy Turnstile or PayPal test keys in production.
#
# Canonical process manager: deploy/systemd/*.service (EnvironmentFile=-/etc/bidvera/env).
# Do not invent a second env path under /opt/bidvera unless you update the units to match.

NODE_ENV=production
PORT=3000
# Bind loopback when Nginx (or another reverse proxy) terminates TLS on the same host.
# Change only if the app must listen on a private interface behind a remote load balancer.
HOSTNAME=127.0.0.1

# Public HTTPS origin (must match Nginx server_name / TLS cert). Code reads NEXT_PUBLIC_APP_URL (not APP_URL).
NEXT_PUBLIC_APP_URL=https://YOUR_DOMAIN
NEXT_PUBLIC_APP_NAME=Bidvera

# Postgres (pooler URL for the app is fine)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/bidvera?schema=public
# Non-pooler URL for pg_dump backups — required for Production readiness "backups" = READY
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST:5432/bidvera?schema=public
#
# Prisma client pool (per Node process). Defaults applied in src/lib/prisma-url.ts when unset:
#   - Neon/pgbouncer pooler hosts: connection_limit=5 (keep small under plan caps)
#   - Dedicated local Postgres: connection_limit=40
#   - Other non-pooler hosts: connection_limit=20
#
# CONNECTION BUDGET (mandatory operator math before multi-instance Go-Live):
#   (N_app + N_worker) × PRISMA_CONNECTION_LIMIT  <  max_connections_or_pooler_slots
#   Leave headroom for migrations, psql, and DATABASE_URL_DIRECT backups.
# See docs/production-capacity.md Profiles A/B/C — do NOT invent PRISMA_CONNECTION_LIMIT=40.
#
# Profile A example (3 app + 1 worker, dedicated Postgres max_connections≥200):
#   PRISMA_CONNECTION_LIMIT=15
#   → ~60 client slots
# Profile B example (5 app + 1 worker):
#   PRISMA_CONNECTION_LIMIT=12
#   → ~72 client slots
# Neon / tight pooler:
#   PRISMA_CONNECTION_LIMIT=5
# PRISMA_CONNECTION_LIMIT=
# PRISMA_POOL_TIMEOUT=20
#
# Production refuses logical-only backups unless explicitly allowed (emergency only):
# BACKUP_ALLOW_LOGICAL=1
# Isolated restore target only — must NOT equal DATABASE_URL or DATABASE_URL_DIRECT
# Leave empty until you provision a dedicated restore DB. Archive verify still works without it.
# Required before claiming DR READY on a VPS: set this and run docs/disaster-recovery.md restore-test.
BACKUP_RESTORE_DATABASE_URL=

# Auth (≥32 random characters). Also derives backup encryption (AES-256-GCM).
# There is NO separate BACKUP_ENCRYPTION_KEY — losing AUTH_SECRET makes archives unreadable.
AUTH_SECRET=

# Super Admin (unguessable path ≥12 chars; strong unique password — no demo passwords)
# Set BOTH email and password before first seed / sa:sync. Never commit real values.
# After rotating credentials on the VPS: update this file, then run: npm run sa:sync
SUPER_ADMIN_PATH=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_SESSION_HOURS=8

# Rate limiting — durable Postgres buckets only in production (never "memory")
# Required for multi-instance: in-memory buckets diverge per process.
RATE_LIMIT_BACKEND=durable

# Optional instance label (systemd template sets INSTANCE_ID=app-%i automatically)
# INSTANCE_ID=app-3000

# Persistent volumes (absolute paths; must survive redeploys; must NOT be the same directory)
# Company tender/package documents live under STORAGE_ROOT.
# Multi-instance on one host: all app units + worker MUST share these paths.
# Also holds pending password-archive uploads at $STORAGE_ROOT/pending-archives (ephemeral TTL).
STORAGE_ROOT=/var/lib/bidvera/uploads
# Encrypted platform backups (AES-GCM via AUTH_SECRET). Prefer off-host / separate volume.
BACKUP_ROOT=/var/lib/bidvera/backups
#
# ALSO persist across releases (not under STORAGE_ROOT — written into the app tree):
#   /opt/bidvera/public/uploads/avatars
#   /opt/bidvera/public/uploads/landing
# Symlink or bind-mount those to /var/lib/bidvera/public-uploads/{avatars,landing} so
# rsync/git deploy of /opt/bidvera does not wipe profile photos or landing media.
# Multi-instance / multi-host: these directories MUST be on shared persistent storage
# (same bind-mount or NFS) — Next serves them from each instance's public/ tree.

# PayPal LIVE only
PAYPAL_ENVIRONMENT=production
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Prefer Super Admin plan ID mappings; optional env fallbacks:
# PAYPAL_PLAN_STARTER=
# PAYPAL_PLAN_PRO=
# PAYPAL_PLAN_BUSINESS=

# Cloudflare Turnstile (production keys — never Cloudflare dummy keys)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (or configure Resend via Super Admin vault)
RESEND_API_KEY=
EMAIL_FROM=Bidvera <noreply@YOUR_DOMAIN>

# Stripe optional — omit entirely for PayPal-only. If set, use live keys only.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Matching Engine / TED / Sponsored Matching stay OFF unless you explicitly enable them
# in Super Admin entitlement / TED settings. Do not set experimental activation flags here.
